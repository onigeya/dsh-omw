# dependencies
node_modules/
.pnpm-store/

# build output（仅两包的构建产物：tsdown → packages/*/lib/index.js，
# tsc → packages/*/lib/types；由 prepack 重建，不入库。锚定在 packages/*/ 下，
# 避免误吞将来名为 lib/ 的源码/资源目录）
packages/*/lib/
dist/
*.tsbuildinfo

# test
coverage/
.coverage*

# env & secrets
.env
.env.*

# logs & debug
pnpm-debug.log
*.log

# editor & OS
.vscode/
.idea/
.DS_Store

# dsh local profile artifacts (never commit)
.storages/
.sessions/
.temp/
*.tgz
!.env.example
