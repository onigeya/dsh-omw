{
  "name": "dsh-oh-my-whale-memory",
  "version": "0.1.0",
  "description": "DSH 记忆插件的 function 插件（cordis 模块名 dsh-oh-my-whale-memory，AD-2）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./compaction": {
      "types": "./lib/types/compaction.d.ts",
      "default": "./lib/compaction.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/compaction.js",
    "lib/*.js",
    "lib/types"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "~0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@ladybugdb/core": "~0.22.3",
    "n3": "^1.17.2"
  },
  "optionalDependencies": {
    "@ladybugdb/wasm-core": "~0.22.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/n3": "^1.26.6",
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.7",
    "typescript": "~5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onigeya/dsh-omw.git",
    "directory": "packages/dsh-oh-my-whale-memory"
  },
  "publishConfig": {
    "access": "public"
  }
}
